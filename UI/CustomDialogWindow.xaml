<Window x:Class="MusicMediaKeys.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предупреждение" MinHeight="150" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusVisualStyle="{x:Null}"
        MouseDown="Window_MouseDown" KeyDown="Window_KeyDown">

    <Border CornerRadius="10" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgHeader}" CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TealAccent}"/>
                        <TextBlock x:Name="TxtTitle" Text="Предупреждение" Foreground="{DynamicResource TextGray}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButton}" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,14" VerticalAlignment="Center">
                <TextBlock x:Name="TxtMessage" Text="Сообщение" Foreground="{DynamicResource TextWhite}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                <TextBox x:Name="TxtInput" Height="28" Margin="0,10,0,0" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDark}" Foreground="{DynamicResource TextWhite}" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource BgHeader}" CornerRadius="0,0,10,10">
                <Grid Margin="14,0" VerticalAlignment="Center">
                    <Button x:Name="BtnInfo" Content="Почему?" Style="{StaticResource SecondaryButton}" MinWidth="76" Height="26" Padding="10,0" HorizontalAlignment="Left" Cursor="Help" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Выход" Style="{StaticResource SecondaryButton}" MinWidth="82" Height="26" Margin="0,0,8,0" Click="BtnCancel_Click" Visibility="Collapsed"/>

                        <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryButton}" MinWidth="76" Height="26" Padding="12,0" Click="BtnOk_Click" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
