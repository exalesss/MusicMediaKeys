<Window x:Class="MusicMediaKeys.Installer.LanguageCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interface Languages"
        Width="520"
        Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="None"
        FocusVisualStyle="{x:Null}"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="10" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgHeader}" CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="Языки интерфейса" Foreground="{DynamicResource TextGray}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButton}" Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Border Height="30" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextWhite}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="Поиск языка..." Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnSelectAll" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" FontSize="11" Margin="0,0,8,0" Click="BtnSelectAll_Click"/>
                        <Button x:Name="BtnCurrentAndEnglish" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" FontSize="11" Click="BtnCurrentAndEnglish_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCountSummary" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextGray}" FontSize="11"/>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <UniformGrid x:Name="GridLanguages" Columns="2" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource BgHeader}" CornerRadius="0,0,10,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButton}" MinWidth="84" Height="28" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnDone" Style="{StaticResource PrimaryButton}" MinWidth="92" Height="28" Click="BtnDone_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
