<UserControl x:Class="MusicMediaKeys.UpdateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock x:Name="TxtStatus" FontSize="11.5" Foreground="{DynamicResource TextGray}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="ProgressTrack" Height="4" Margin="0,4,0,0" CornerRadius="2" Background="{DynamicResource BgInput}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressDone" Width="0*"/>
                        <ColumnDefinition x:Name="ProgressLeft" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2" Background="{DynamicResource TealAccent}"/>
                </Grid>
            </Border>
        </StackPanel>

        <Button x:Name="BtnAction" Grid.Column="1" Style="{StaticResource SecondaryButton}" MinWidth="100" Height="28" Padding="12,0" FontSize="11" Click="BtnAction_Click"/>
    </Grid>
</UserControl>
