<Window x:Class="MusicMediaKeys.OverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MusicMediaKeys"
        Title="Настройки оверлея"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusVisualStyle="{x:Null}"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="MarqueeMonitorComboBox" TargetType="local:NonModalComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          ClickMode="Press"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="&#xE015;" FontFamily="Segoe MDL2 Assets" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextGray}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TealAccent}"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TealAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TealAccent}"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TealAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="PART_MarqueeClip" Margin="8,4,26,4" ClipToBounds="True" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock x:Name="PART_MarqueeText" Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="PART_MarqueeTransform" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="true" Focusable="false" PopupAnimation="None">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="true" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="true">
                                            <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PositionCell" TargetType="RadioButton">
            <Setter Property="GroupName" Value="OverlayPosition"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="5">
                            <Border x:Name="Marker" Width="46" Height="16" CornerRadius="3" BorderThickness="1"
                                    Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDark}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marker" Property="BorderBrush" Value="{DynamicResource TealHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Marker" Property="Background" Value="{DynamicResource TealAccent}"/>
                                <Setter TargetName="Marker" Property="BorderBrush" Value="{DynamicResource TealAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgHeader}" CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TealAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitle" Text="Настройки оверлея" Foreground="{DynamicResource TextGray}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseButton}" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,10">
                <TextBlock x:Name="LblPositionHeader" Text="Выберите положение на экране:" Foreground="{DynamicResource TealAccent}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="280" Height="150" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="6" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="PosTopLeft" Tag="TopLeft" Grid.Row="0" Grid.Column="0" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosTopCenter" Tag="TopCenter" Grid.Row="0" Grid.Column="1" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosTopRight" Tag="TopRight" Grid.Row="0" Grid.Column="2" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosMiddleLeft" Tag="MiddleLeft" Grid.Row="1" Grid.Column="0" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosMiddleRight" Tag="MiddleRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosBottomLeft" Tag="BottomLeft" Grid.Row="2" Grid.Column="0" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosBottomCenter" Tag="BottomCenter" Grid.Row="2" Grid.Column="1" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Checked="Position_Checked"/>
                            <RadioButton x:Name="PosBottomRight" Tag="BottomRight" Grid.Row="2" Grid.Column="2" Style="{StaticResource PositionCell}" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" Checked="Position_Checked"/>
                        </Grid>
                    </Border>

                    <Border Width="36" Height="14" Background="{DynamicResource BorderDark}" HorizontalAlignment="Center"/>
                    <Border Width="104" Height="5" Background="{DynamicResource BorderDark}" CornerRadius="2.5" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPositionName" Foreground="{DynamicResource TextGray}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblDuration" Text="Длительность показа:" Foreground="{DynamicResource TextGray}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="TxtDurationVal" Text="3 сек." Foreground="{DynamicResource TealAccent}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
                <Slider x:Name="SldDuration" Style="{StaticResource ThemedSlider}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" Margin="0,0,0,14"
                        ValueChanged="SldDuration_ValueChanged" Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblScale" Text="Масштаб интерфейса:" Foreground="{DynamicResource TextGray}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="TxtScaleVal" Text="100%" Foreground="{DynamicResource TealAccent}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
                <Slider x:Name="SldScale" Style="{StaticResource ThemedSlider}" Minimum="75" Maximum="140" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" Margin="0,0,0,12"
                        ValueChanged="SldScale_ValueChanged" Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblMonitor" Text="Монитор для оверлея:" Foreground="{DynamicResource TextGray}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <local:NonModalComboBox x:Name="ComboMonitor" Grid.Column="1" Style="{StaticResource MarqueeMonitorComboBox}" MinWidth="120" Height="28" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderDark}" Foreground="{DynamicResource TextWhite}" SelectionChanged="ComboMonitor_SelectionChanged" MouseEnter="ComboMonitor_MouseEnter" MouseLeave="ComboMonitor_MouseLeave"/>
                </Grid>

                <CheckBox x:Name="ChkShowOnTrackChange" Content="Показывать автоматически при смене трека" Margin="0,0,0,8" Checked="ChkShowOnTrackChange_Changed" Unchecked="ChkShowOnTrackChange_Changed"/>
                <CheckBox x:Name="ChkHideInFullscreen" Content="Не показывать поверх полноэкранных приложений" Margin="0,0,0,6" Checked="ChkHideInFullscreen_Changed" Unchecked="ChkHideInFullscreen_Changed"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource BgHeader}" CornerRadius="0,0,10,10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Button x:Name="BtnTestPreview" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" MinWidth="110" Padding="10,0" FontSize="11" Click="BtnTestPreview_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,1,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TealAccent}"/>
                            <TextBlock x:Name="TxtPreviewBtn" Text="Тестовый показ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDone" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnDone_Click">
                        <TextBlock x:Name="TxtDoneBtn" Text="Готово"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
